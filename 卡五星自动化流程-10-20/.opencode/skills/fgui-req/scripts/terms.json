    { "正字": "被自摸", "变体": ["被自模"], "说明": "自摸时输分玩家的负面标签" },
    { "正字": "包牌", "变体": ["包牌?"], "说明": "包牌赔付相关标签" },
    { "正字": "查叫", "变体": ["查教", "查叫?"], "说明": "查叫时赢分玩家的正面标签" },
    { "正字": "被查叫", "变体": ["被查教"], "说明": "查叫时输分玩家的负面标签" },
    { "正字": "亮倒", "变体": ["亮到", "亮捣"], "说明": "亮倒玩法；「到」是常见错写" },
    { "正字": "首亮赔付", "变体": ["首亮赔附", "首亮培付", "首亮赔付?"], "说明": "亮倒赔付的标签文案（需确认是否分「被首亮赔付」）" },
    { "正字": "封顶", "变体": ["封頂", "封顶?"], "说明": "番型封顶标识，只在输的玩家显示" },
    { "正字": "漂", "变体": ["飘", "瞟", "縹"], "说明": "漂玩法（漂X / 漂分）；「飘」是常见错写" },
    { "正字": "坎", "变体": ["砍", "坎?"], "说明": "坎分（卡五星计分项）" },
    { "正字": "马", "变体": ["碼", "码"], "说明": "马分（卡五星计分项）" },
    { "正字": "杠", "变体": ["槓", "杠?"], "说明": "杠分 / 杠牌" },
    { "正字": "庄", "变体": ["莊"], "说明": "庄家角标【庄】" },
    { "正字": "本家", "变体": ["夲家"], "说明": "【X家】四种之一" },
    { "正字": "上家", "变体": ["上傢"], "说明": "【X家】四种之一" },
    { "正字": "下家", "变体": ["下傢"], "说明": "【X家】四种之一" },
    { "正字": "对家", "变体": ["對家"], "说明": "【X家】四种之一" },
    { "正字": "结算", "变体": ["结祘", "结算?"], "说明": "结算界面" },
    { "正字": "手牌", "变体": ["手排"], "说明": "手牌区" },
    { "正字": "页签", "变体": ["页签?"], "说明": "需求里的「胡牌页签 / 详情页签」" },
    { "正字": "番型", "变体": ["翻型", "番形"], "说明": "番型封顶" },
    { "正字": "胡分", "变体": ["胡份", "糊分"], "说明": "信息行分项字段名" },
    { "正字": "字分", "变体": ["字份", "自分"], "说明": "信息行分项字段名（大写汉字一~九+中发白）" },
