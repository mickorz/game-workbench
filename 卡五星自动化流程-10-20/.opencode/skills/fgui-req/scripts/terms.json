{
  "version": 1,
  "说明": "术语表：正字 + 常见错写/异体。check_terms.py 用它做错别字与用词统一性检查。正字以工程/需求里已有的写法为准，改这个表前先确认。",
  "label_ignore": ["庄", "漂X", "漂", "封顶", "X家", "本家", "上家", "下家", "对家"],
  "list_line_prefixes": ["正面", "负面", "正面标签", "负面标签", "正面清单", "负面清单"],
  "score_fields": ["胡分", "杠分", "漂分", "马分", "坎分", "字分", "数字", "番型"],
  "terms": [
    { "正字": "捉炮胡", "变体": ["捉跑胡", "捉炮糊", "捉跑糊"], "说明": "点炮胡牌的赢家标签；「跑」是常见错写" },
    { "正字": "点炮", "变体": ["点砲", "奌炮"], "说明": "放炮的输家标签（正式文案用「点炮」；「放炮玩家」是描述不是标签，不算错）" },
    { "正字": "一炮多响", "变体": ["一炮多響", "一炮多响?"], "说明": "一炮多响时点炮玩家的标签" },
